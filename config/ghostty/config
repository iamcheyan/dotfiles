# ===== Font =====
font-family = MesloLGS Nerd Font Mono
font-size = 11

# ===== Colors (Neovim Blue / Nostalgia) =====
background = #0000aa
foreground = #ffff55
cursor-color = #ffffff
selection-background = #1e1ec8
selection-foreground = #ffffff

palette = 0=#000080
palette = 1=#aa0000
palette = 2=#00aa00
palette = 3=#aaaa00
palette = 4=#0000aa
palette = 5=#aa00aa
palette = 6=#00aaaa
palette = 7=#a3be8c
palette = 8=#5f7f5f
palette = 9=#ff5555
palette = 10=#00ff00
palette = 11=#ffff55
palette = 12=#5555ff
palette = 13=#ff55ff
palette = 14=#55ffff
palette = 15=#ffffff

# ===== Clipboard =====
copy-on-select = clipboard

# ===== Window & Decorations =====
window-padding-x = 5
window-padding-y = 5
window-decoration = auto
window-theme = dark
window-border-color = #55ffff
quit-after-last-window-closed = false

# Window management
keybind = f11=toggle_fullscreen

# ===== Performance =====
