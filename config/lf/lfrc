# lf config, inspired by the Ranger setup in this repository.

set preview
set drawbox
set borderstyle roundbox
set icons
set hidden
set ignorecase
set period 1
set info perm:size:time:ctime
set previewer ~/.config/lf/preview

# Keep the familiar h/j/k/l navigation and Ranger-style selection.
map <enter> open
map <space> :toggle; down
map v invert
map zh set hidden!
map zp set preview!
map i ${{
    if command -v bat >/dev/null 2>&1; then
        bat --style=plain --color=always --paging=always -- "$f"
    else
        file "$f" | less
    fi
}}
map dd cut
map yy copy
map pp paste
map dD delete
map cw rename
map S :shell
map / :search
map n search-next
map N search-prev
map ff ${{
    set -f
    if ! command -v fzf >/dev/null 2>&1; then
        printf 'ff requires fzf\\n' >&2
        exit 1
    fi
    if command -v fd >/dev/null 2>&1; then
        fd --hidden --follow --exclude .git | fzf --height 90% --layout=reverse --border --preview '([[ -d {} ]] && ls -la --color=always {}) || ([[ -f {} ]] && bat --color=always --style=numbers --line-range :300 -- {})'
    elif command -v fdfind >/dev/null 2>&1; then
        fdfind --hidden --follow --exclude .git | fzf --height 90% --layout=reverse --border --preview '([[ -d {} ]] && ls -la --color=always {}) || ([[ -f {} ]] && bat --color=always --style=numbers --line-range :300 -- {})'
    else
        find . -type f -not -path '*/.git/*' | fzf --height 90% --layout=reverse --border --preview '([[ -d {} ]] && ls -la --color=always {}) || ([[ -f {} ]] && bat --color=always --style=numbers --line-range :300 -- {})'
    fi
}}
map fr ${{
    set -f
    if ! command -v rg >/dev/null 2>&1 || ! command -v fzf >/dev/null 2>&1; then
        printf 'fr requires ripgrep and fzf\\n' >&2
        exit 1
    fi
    selected=$(rg --line-number --color=never --hidden --glob '!.git/**' . | fzf --delimiter : --nth 3.. --preview 'bat --color=always --style=numbers --highlight-line {2} -- {1}' --preview-window 'right:60%:wrap') || exit 0
    [ -n "$selected" ] && lf -remote "send $id select \"${selected%%:*}\""
}}
map z ${{
    set -f
    if ! command -v zoxide >/dev/null 2>&1 || ! command -v fzf >/dev/null 2>&1; then
        printf 'z jump requires zoxide and fzf\\n' >&2
        exit 1
    fi
    target=$(zoxide query --list --score | fzf --height 60% --layout=reverse --border --with-nth 2.. | sed 's/^[^ ]* //') || exit 0
    [ -d "$target" ] && lf -remote "send $id cd \"$target\""
}}
map tw ${{
    set -f
    if [ -n "${TMUX:-}" ]; then
        tmux new-window -c "$PWD"
    else
        printf 'Not inside tmux\\n' >&2
        exit 1
    fi
}}
map st set sortby time
map sn set sortby natural
map e $$EDITOR "$f"
map q quit

# Open files with the user's configured editor and directories with lf's default.
cmd open ${{
    set -f
    if [ -d "$f" ]; then
        lf -remote "send $id open"
    else
        $EDITOR "$f"
    fi
}}

# Handy archive operations, available when the matching system tools exist.
cmd extract ${{
    set -f
    case "$f" in
        *.tar.bz|*.tar.bz2|*.tbz|*.tbz2) tar xjf "$f" ;;
        *.tar.gz|*.tgz) tar xzf "$f" ;;
        *.tar.xz|*.txz) tar xJf "$f" ;;
        *.tar.zst|*.tzst) tar --zstd -xf "$f" ;;
        *.zip) unzip "$f" ;;
        *.rar) unrar x "$f" ;;
        *.7z) 7z x "$f" ;;
        *) printf 'Unsupported archive: %s\n' "$f" >&2; exit 1 ;;
    esac
}}
map ex extract

cmd compress ${{
    set -f
    printf 'Archive format (zip/tar.gz/tar.xz/tar.zst): '
    read format
    case "$format" in
        zip) zip -r "$f.zip" $fx ;;
        tar.gz) tar czf "$f.tar.gz" $fx ;;
        tar.xz) tar cJf "$f.tar.xz" $fx ;;
        tar.zst) tar --zstd -cf "$f.tar.zst" $fx ;;
        *) printf 'Unsupported format: %s\n' "$format" >&2; exit 1 ;;
    esac
}}
map ec compress
