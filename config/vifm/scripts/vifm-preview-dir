#!/bin/sh

if [ "$#" -ne 1 ] || [ ! -d "$1" ]; then
    printf 'Directory preview unavailable.\n'
    exit 0
fi

if command -v eza >/dev/null 2>&1; then
    export LS_COLORS='di=1;36:ln=36:ex=1;32:or=1;31:mi=1;31'
    exec eza --icons=always --color=always --group-directories-first --oneline -- "$1"
fi

exec ls -1pA "$1"
