" GVim-only presentation. Shared editing defaults, mappings, and Blue theme
" are provided by the public dotfiles ~/.vimrc.
if has("gui_running")
  set guioptions-=T
  set guioptions-=L
  set guioptions-=r
  set guioptions-=b

  if exists("+guifont")
    set guifont=MesloLGS\ Nerd\ Font\ Mono\ 12
  endif
endif
